# Copia este archivo como ".env" y llena los valores.

# Proyecto de Supabase al que apuntan las pruebas. Son los mismos valores que
# NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY en la app.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Dos usuarios dedicados a las pruebas de API, ya confirmados en Supabase Auth.
# Hacen falta dos para probar que cada usuario solo ve sus propias filas (RLS).
# No uses tu cuenta personal ni el usuario de la suite E2E: las pruebas crean y
# borran filas con estos usuarios.
API_USER_A_EMAIL=
API_USER_A_PASSWORD=
API_USER_B_EMAIL=
API_USER_B_PASSWORD=
